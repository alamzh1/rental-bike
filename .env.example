# Все переменные окружения проекта. Значения не коммитятся: скопируйте в .env и заполните.
# Пустое значение = локальное значение по умолчанию из scripts/env-defaults.mjs (dev) или выключенная интеграция.

# --- Режим ---
NODE_ENV=
# 1 — тестовые пользователи (клиент, менеджер, админ) без Telegram; local — кнопки входа в админку только в браузере на этой машине (для работы с туннелем); в prod выключено
DEV_AUTH=
API_PORT=
# 1 — записать docs/openapi.json при старте API
# Публичные адреса (для ссылок бота, CORS, Login Widget)
MINIAPP_URL=
ADMIN_URL=
API_PUBLIC_URL=

# --- PostgreSQL ---
DATABASE_URL=
# База для интеграционных тестов (pnpm test:integration создаёт её сама)
DATABASE_URL_TEST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
BACKUP_RETENTION_DAYS=

# --- Redis / BullMQ ---
REDIS_URL=
REDIS_PORT=
# Очереди: bullmq | memory; пусто = bullmq при заданном REDIS_URL
JOBS_DRIVER=

# --- S3 / MinIO ---
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_PUBLIC_URL=
# Шифрование загрузок в приватный бакет: пусто = AES256; none — выключить (MinIO без KMS)
S3_SSE=
# Хранилище файлов: local | s3; пусто = s3 при заданных S3_ENDPOINT и ключах, иначе локальная папка storage/
STORAGE_DRIVER=
# Папка локального хранилища (по умолчанию storage/ в корне)
STORAGE_DIR=
# Секрет подписи ссылок и шифрования файлов локального хранилища
PAYMENT_KEYS_SECRET=
TEST_PAY_TELEGRAM_IDS=
IP_RATE_LIMIT=
API_HOST=
FILES_SIGNING_SECRET=
# Образы MinIO и mc (официальные minio/minio, minio/mc больше не публикуются на Docker Hub — укажите доступный)
MINIO_IMAGE=
MC_IMAGE=
MINIO_PORT=
MINIO_CONSOLE_PORT=

# --- Авторизация ---
JWT_SECRET=
ADMIN_SESSION_SECRET=
# Telegram ID администраторов через запятую
ADMIN_TELEGRAM_IDS=

# --- Telegram-бот (без токена — LogNotifier, сообщения в лог) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Чат для алертов об ошибках оплаты и падении задач
ADMIN_ALERT_CHAT_ID=

# --- payOS / VietQR (без ключей — TestProvider) ---
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# IP-адреса webhook через запятую (если задано — остальные отклоняются)
PAYOS_WEBHOOK_IPS=
# Express trust proxy для req.ip за обратным прокси: пусто = loopback (прокси на той же машине); число — сколько прокси перед API; true/false; список адресов/подсетей через запятую
TRUST_PROXY=
# Адрес API payOS (пусто = https://api-merchant.payos.vn)
PAYOS_API_URL=

# --- GPS ---
# Секрет приёма точек от Traccar Server (пусто — приём по ID устройства выключен; адрес из карточки байка работает всегда)
GPS_FORWARD_SECRET=

# --- Мониторинг ---
SENTRY_DSN=

# --- e2e и нагрузка (необязательно) ---
# Порты API и Mini App для `pnpm e2e` (по умолчанию 3100 и 5183, чтобы не мешать `pnpm dev`)
E2E_API_PORT=
E2E_MINIAPP_PORT=
# Адрес API для `pnpm load` (по умолчанию http://localhost:3000) и токен бота стенда для подписи initData синтетических клиентов
LOAD_BASE_URL=
LOAD_BOT_TOKEN=
